{
  "name": "@coderminer/fetch-event-source",
  "version": "3.1.0",
  "description": "A better API for making Event Source requests, with all the features of fetch() - maintained fork of @microsoft/fetch-event-source",
  "keywords": [
    "eventsource",
    "event-source",
    "server-sent-events",
    "sse",
    "fetch",
    "streaming",
    "event-driven",
    "fetch-event-source"
  ],
  "homepage": "https://github.com/coderminer/fetch-event-source#readme",
  "repository": "github:coderminer/fetch-event-source",
  "bugs": {
    "url": "https://github.com/coderminer/fetch-event-source/issues"
  },
  "author": "coderminer",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf ./lib ./coverage",
    "prebuild": "npm run clean",
    "build": "tsc && tsc -p tsconfig.esm.json",
    "pretest": "npm run build",
    "test": "nyc jasmine --config=jasmine.json",
    "posttest": "npm run check:fragments",
    "check:fragments": "node scripts/check-tool-fragments.cjs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/jasmine": "^4.3.1",
    "jasmine": "^3.7.0",
    "nyc": "^15.1.0",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.19",
    "typescript": "^4.2.4"
  }
}
